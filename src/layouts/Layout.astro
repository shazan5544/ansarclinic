---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import { site } from '../data/site';

interface Props {
  canonical: string;
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
}

const {
  canonical,
  title = 'Ansar Clinic: Mardon ki Sex Problems ka Ayurvedic Ilaaj',
  lang = 'en-IN',
  description = 'Premature ejaculation, erectile dysfunction, nightfall aur dhaat rog ka desi ayurvedic ilaaj. 100% private consultation, ghar tak delivery.',
  ogImage = `${site.url}/assets/img/og-image.png`,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ansar Clinic" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="facebook-domain-verification" content="z66n5ivyl6ufln0xm30s8nbdczdujk" />
    <slot name="head" />

    <link rel="icon" type="image/svg+xml" href="/assets/img/round_logo.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap"
    />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-17497624193"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-17497624193');
    </script>

    <!-- Meta Pixel (two pixel IDs, one loader) -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1936601976920824');
      fbq('init', '2112440722598023');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=1936601976920824&ev=PageView&noscript=1" /></noscript>
    <noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=2112440722598023&ev=PageView&noscript=1" /></noscript>

    <script is:inline defer src="https://umami.shazan.in/script.js" data-website-id="f688d00c-87e1-404b-a1e9-055dd37b35e9"></script>
  </head>
  <body>
    <a class="skip" href="#main">Main content par jayein</a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ActionBar />
  </body>
</html>
