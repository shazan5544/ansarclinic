  { q: 'Swapnadosh aur kamzori se pareshan tha. Doctor ne bahut ache se suna aur sahi dawa di, ab problem khatam ho gayi.', name: 'Sandeep', meta: '27 saal, Jaipur' },
  { q: 'Dhaat rog se bahut kamzori aa gayi thi, kaam me man nahi lagta tha. Dawa lene ke baad taqat wapas aa gayi, ab fresh feel hota hai.', name: 'Vikash', meta: '30 saal, Lucknow' },
