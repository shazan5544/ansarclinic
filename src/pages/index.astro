const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Ansar Clinic Online', url: site.url },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalBusiness',
    name: 'Ansar Clinic',
    description: "Mardon ki sex problems ka Ayurvedic aur Unani ilaaj, premature ejaculation, erectile dysfunction, nightfall aur dhaat rog",
    url: site.url,
    telephone: site.phoneRaw,
    email: site.email,
    foundingDate: '1985',
    image: `${site.url}/assets/img/og-image.png`,
    sameAs: [site.facebook, site.instagram],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout canonical={`${site.url}/`}>
  {jsonLd.map((d) => <script slot="head" type="application/ld+json" set:html={JSON.stringify(d)} />)}

