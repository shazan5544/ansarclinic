      <div class="contact-visual">
        <ul class="contact-list">
          <li>
            <a href={telUrl}>
              <span class="k"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.08 4.18 2 2 0 0 1 4.06 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
              <span class="ct"><strong>Phone</strong><span class="v">{site.phoneDisplay}</span></span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>
              <span class="k"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg></span>
              <span class="ct"><strong>Email</strong><span class="v">{site.email}</span></span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Animated counters in the trust strip
  const counters = document.querySelectorAll<HTMLElement>('.counter');
  const runCounter = (el: HTMLElement) => {
    const target = Number(el.dataset.count || '0');
    const suffix = el.dataset.suffix || '';
    const dur = 1200;
    const start = performance.now();
    const tick = (t: number) => {
      const p = Math.min((t - start) / dur, 1);
      el.textContent = Math.floor(p * target) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) { runCounter(e.target as HTMLElement); io.unobserve(e.target); }
    });
  }, { threshold: 0.4 });
  counters.forEach((c) => io.observe(c));

  // Testimonials carousel
  const track = document.getElementById('tTrack');
  if (track) {
    document.querySelectorAll<HTMLElement>('.t-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.t-card');
        const step = card ? card.getBoundingClientRect().width + 16 : 320;
        track.scrollBy({ left: Number(btn.dataset.dir) * step, behavior: 'smooth' });
      });
    });
  }

  // FAQ: one open at a time
  const faqItems = document.querySelectorAll<HTMLElement>('.faq details');
  faqItems.forEach((d) => {
    d.addEventListener('toggle', () => {
      if ((d as HTMLDetailsElement).open) {
        faqItems.forEach((o) => { if (o !== d) (o as HTMLDetailsElement).open = false; });
      }
    });
  });
</script>
