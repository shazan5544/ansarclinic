---
import PolicyPage from '../components/PolicyPage.astro';
---

<PolicyPage
  title="Privacy Policy"
  path="privacy-policy.html"
  intro={[
    'At Ansar Clinic, your privacy matters to us and we are committed to safeguarding your personal information. This Privacy Policy explains how we collect, use, and protect the information you share when using our website www.ansarcliniconline.com (the "Site") and our services.',
    'By accessing or using the Site, you agree to the terms of this Privacy Policy.',
  ]}
  sections={[
    { heading: 'Information We Collect', blocks: [
      'When you use our Site or services, we may collect the following information:',
      [
        '<strong>Personal Information:</strong> Name, age, gender, contact number, email address, shipping address, and health details provided for consultation.',
        '<strong>Payment Information:</strong> Payment details for purchasing Ayurvedic products (we do not store your full payment data; transactions are processed via secure gateways).',
        '<strong>Technical Information:</strong> IP address, browser type, device information, and pages you visit on our Site.',
      ],
    ] },
    { heading: 'How We Use Your Information', blocks: [
      [
        'Provide health consultations and deliver Ayurvedic medicines',
        'Process your orders and payments securely',
        'Improve our services, website content, and customer experience',
        'Send updates, promotional offers, or health-related information (you can opt out anytime)',
        'Ensure compliance with applicable laws and maintain internal records',
      ],
      'We do not sell or rent your personal information to third parties.',
    ] },
    { heading: 'Information Security', blocks: [
      'We apply reasonable security measures to protect your information from unauthorized access, loss, or misuse. However, no online system is completely secure, and we cannot guarantee absolute protection.',
    ] },
    { heading: 'Data Sharing', blocks: [
      'We may share your information in the following situations:',
      [
        'With trusted service providers who help us deliver products or services',
        'To comply with legal obligations, court orders, or law enforcement requests',
        'To protect our rights, safety, or the rights of others',
        'In connection with a business transfer, merger, or sale',
      ],
    ] },
    { heading: 'Cookies and Tracking Technologies', blocks: [
      'We may use cookies or similar technologies to improve your experience on our Site. You can control cookie settings through your browser. Disabling cookies may affect certain site functions.',
    ] },
    { heading: 'Third-Party Links', blocks: [
      'Our Site may contain links to third-party websites. We are not responsible for the privacy practices of those sites. Please review their policies separately.',
    ] },
    { heading: 'Your Rights', blocks: [
      [
        'Access the personal information we hold about you',
        'Request corrections to incorrect or outdated information',
        'Withdraw your consent or request deletion of your data (subject to legal requirements)',
      ],
      'To exercise these rights, contact us at <a href="mailto:mail@ansarcliniconline.com">mail@ansarcliniconline.com</a>.',
    ] },
    { heading: 'Children\u2019s Privacy', blocks: [
      'Our services are intended for individuals aged 18 years and above. We do not knowingly collect information from minors.',
    ] },
    { heading: 'Changes to this Privacy Policy', blocks: [
      'We may update this Privacy Policy from time to time. Changes will be posted on this page with a new effective date. Continued use of the Site implies your acceptance of the updated policy.',
    ] },
  ]}
  outro={['Your privacy matters to us. We are committed to keeping your health information confidential and secure.']}
/>
